# Copy to android/keystore.properties and point at the release keystore.
# NEVER commit the real file or the .jks itself.
#
# The keystore must never be regenerated: Android identifies an installed app by
# its signing certificate, so a new key means every update needs a reinstall.
storeFile=pager-release.jks
storePassword=CHANGE_ME
keyAlias=androiddebugkey
keyPassword=CHANGE_ME
