# Grandpa Pager — environment template.
# Copy to `.env` and fill in. NEVER commit the real values (`.env*` is ignored).

# Flespi account Master token — used ONLY offline to mint the scoped tokens below.
# Keep it off every client device.
FLESPI_TOKEN=

# Scoped ACL tokens, one variable per role (copy to `.env.tokens`):
#   - publish `grandpa/message`, subscribe `grandpa/status`, origins=<your pages origin>
#   - origins: [] (backend-only), subscribe `grandpa/message`, publish `grandpa/status`
# See docs/flespi-setup.md for the exact ACL JSON.
GRANDPA_WEB_SENDER_TOKEN=
GRANDPA_PHONE_RECEIVER_TOKEN=
